PORT=3000

# SQL Server
DB_SERVER=localhost
# Instancia por defecto local: dejar DB_PORT vacío usa memoria compartida.
# Descomenta solo si conectas por TCP a un puerto concreto.
# DB_PORT=1433
DB_DATABASE=TktInventorySolution
# "windows" usa la sesión de Windows que ejecuta Node.js.
DB_AUTH_TYPE=windows
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Secreto para firmar los JWT de sesión. Cambiar en producción.
JWT_SECRET=cambiar-en-produccion
